# CompilerName=mingw64
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/win64
matlabdir = D:/Program Files/MATLAB/R2026b
startdir = D:/Final Year Project/Objective--4_software-in-loop/Rajasthan/matlab

# Toolchain information
cc = C:\ProgramData\MATLAB\SupportPackages\R2026b\3P.instrset\mingw_w64.instrset\bin\gcc.exe
cxx = C:\ProgramData\MATLAB\SupportPackages\R2026b\3P.instrset\mingw_w64.instrset\bin\g++.exe
linker = C:\ProgramData\MATLAB\SupportPackages\R2026b\3P.instrset\mingw_w64.instrset\bin\gcc.exe
linkerxx = C:\ProgramData\MATLAB\SupportPackages\R2026b\3P.instrset\mingw_w64.instrset\bin\g++.exe

cflags =  -c -fexceptions -fno-omit-frame-pointer -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c99 -I "D:\Final Year Project\Objective--4_software-in-loop\Rajasthan\export_r1\codegen_mex" -I "D:\Final Year Project\Objective--4_software-in-loop\Rajasthan\matlab" -I "D:\Final Year Project\Objective--4_software-in-loop\Rajasthan\export_r1\codegen_mex\interface" -I "D:\Program Files\MATLAB\R2026b\extern\include" -I "." -DMODEL=controller_step_mex -D__USE_MINGW_ANSI_STDIO=1 -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized 

cxxflags =  -c -fexceptions -fno-omit-frame-pointer -m64 -DMATLAB_MEX_FILE  -DMATLAB_MEX_FILE -O2 -fwrapv -DNDEBUG -std=c++11 -I "D:\Final Year Project\Objective--4_software-in-loop\Rajasthan\export_r1\codegen_mex" -I "D:\Final Year Project\Objective--4_software-in-loop\Rajasthan\matlab" -I "D:\Final Year Project\Objective--4_software-in-loop\Rajasthan\export_r1\codegen_mex\interface" -I "D:\Program Files\MATLAB\R2026b\extern\include" -I "." -DMODEL=controller_step_mex -D__USE_MINGW_ANSI_STDIO=1 -msse2 -fno-predictive-commoning -Wno-stringop-overflow -Wno-maybe-uninitialized 

ldflags = controller_step.def  -m64 -Wl,--no-undefined -shared -static -L"D:\Program Files\MATLAB\R2026b\extern\lib\win64\mingw64" -llibmx -llibmex -llibmat -lm -llibmwlapack -llibmwblas -o "controller_step_mex.mexw64" -L"$matlabdir\extern\lib\win64\mingw64" -llibmwblas -llibemlrt -llibcovrt -llibut -llibmwmathutil 

ldxxflags = controller_step.def  -m64 -Wl,--no-undefined -shared -static -L"D:\Program Files\MATLAB\R2026b\extern\lib\win64\mingw64" -llibmx -llibmex -llibmat -lm -llibmwlapack -llibmwblas -llibMatlabDataArray -llibMatlabEngine  -o "controller_step_mex.mexw64" -L"$matlabdir\extern\lib\win64\mingw64" -llibmwblas -llibemlrt -llibcovrt -llibut -llibmwmathutil 

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker @$out.rsp $linkobjs $ldflags
    rspfile = $out.rsp
    rspfile_content = $in

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

# Build
build $builddir/controller_step_data.o : cc $root/controller_step_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/controller_step_initialize.o : cc $root/controller_step_initialize.c
build $builddir/controller_step_terminate.o : cc $root/controller_step_terminate.c
build $builddir/controller_step.o : cc $root/controller_step.c
build $builddir/safety_interlock.o : cc $root/safety_interlock.c
build $builddir/_coder_controller_step_api.o : cc $root/interface/_coder_controller_step_api.c
build $builddir/_coder_controller_step_mex.o : cc $root/interface/_coder_controller_step_mex.c
build $builddir/_coder_controller_step_info.o : cc $root/interface/_coder_controller_step_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root\controller_step_mex.mexw64 : link $builddir/controller_step_data.o $builddir/rt_nonfinite.o $builddir/controller_step_initialize.o $builddir/controller_step_terminate.o $builddir/controller_step.o $builddir/safety_interlock.o $builddir/_coder_controller_step_api.o $builddir/_coder_controller_step_mex.o $builddir/_coder_controller_step_info.o $builddir/c_mexapi_version.o 
